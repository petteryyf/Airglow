# 部署 Airglow 到 BNB Chain 所需的环境变量
# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）

# 部署者私钥（绝不要提交真实私钥到 GitHub）
PRIVATE_KEY=

# BNB Smart Chain RPC 地址
# 公共例：https://bsc-dataseed.binance.org/
# 或用 Ankr / Alchemy / QuickNode 等节点
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Foundry 广播网络的 chain id（BSC 主网 = 56）
CHAIN_ID=56
